[Unit]
Description=Job Market Analytics API
After=network.target postgresql.service

[Service]
User=lander-api
Group=lander-api
SupplementaryGroups=lander-pipeline
WorkingDirectory=/opt/job-market-analytics
EnvironmentFile=/opt/job-market-analytics/.env
Environment=HOME=/var/lib/lander-api
Environment=HF_HOME=/var/cache/lander-api/huggingface
# Nginx is the only public ingress. Binding loopback prevents callers from
# bypassing TLS, Cloudflare, proxy policy, and trusted client-IP handling.
ExecStart=/opt/job-market-analytics/.venv/bin/uvicorn python.api:app --host 127.0.0.1 --port 8000 --workers 1 --no-server-header
Restart=always
RestartSec=5
MemoryHigh=1G
MemoryMax=1536M
MemorySwapMax=256M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/lander-api /var/cache/lander-api

[Install]
WantedBy=multi-user.target
