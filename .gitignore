# Loose backfill scripts at root (dupes of python/ versions)
/bf.py
/bf_*.py
/ec.py
/fc.py
/score_resume.py
/loc_norm*.py

# Streamlit secrets
.streamlit/secrets.toml

# Local DB dumps (root only — sql/ and dbt/ stay tracked)
/*.sql
job_analytics_*.sql

# local provenance input for role taxonomy fixture regen
python/_role_corpus.tsv

# dbt CLI per-machine identity
dbt/**/.user.yml

