def _build_jobs_query(rescan_skills: bool) -> str:
    """
    Default behavior: only process jobs missing structured fields OR jobs with zero skills.

    rescan_skills=True:
      - also include jobs even if they already have skills (useful after adding new aliases).
      - still constrained to description_text NOT NULL.
    """
    # If rescan_skills is enabled, we don't need to gate on "no skills" to include,
    # but we still want to avoid scanning ALL jobs if you only want fields.
    # Here: include jobs missing fields OR (rescan_skills True).
    # This means "rescan_skills" effectively includes all jobs with descriptions,
    # which is intended for occasional refresh runs.
    skills_clause = (
        "OR NOT EXISTS (SELECT 1 FROM job_skills js WHERE js.job_id = jp.job_id)"
        if not rescan_skills
        else "OR TRUE"
    )

    return f"""
        SELECT jp.job_id, jp.description_text, jp.company_id, c.company_name AS existing_company_name, jp.role_id, jp.location_id,
               jp.workplace_type, jp.salary_min, jp.salary_max, jp.salary_period,
               jp.experience_level
        FROM job_postings jp
        LEFT JOIN companies c ON jp.company_id = c.company_id
        WHERE jp.description_text IS NOT NULL
          AND COALESCE(jp.status,'') <> 'legacy_no_desc'
          AND (
                jp.company_id IS NULL
             OR jp.role_id IS NULL
             OR jp.location_id IS NULL
             OR jp.workplace_type IS NULL
             OR jp.salary_min IS NULL
             OR jp.salary_max IS NULL
             OR jp.salary_period IS NULL
             OR jp.experience_level IS NULL
             {skills_clause}
          )
        ORDER BY jp.job_id
    """


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--count-only",
        action="store_true",
        help="Print count of jobs that would be processed (same selection logic) and exit.",
    )
    parser.add_argument(
        "--rescan-skills",
        action="store_true",
        help="Also rescan skills for jobs that already have some skills (use after adding new aliases).",
    )
    args = parser.parse_args()

    conn = get_conn()
    conn.autocommit = False

    try:
        with conn.cursor(cursor_factory=DictCursor) as cur:
            compiled_patterns = load_skill_alias_patterns(cur)

            cur.execute(_build_jobs_query(args.rescan_skills))
            jobs = cur.fetchall()

            if args.count_only:
                print(len(jobs))
                conn.rollback()
                return

            updated_jobs = 0
            inserted_job_skills = 0
            updated_job_skills = 0

            for job in jobs:
                job_id = job["job_id"]
                desc = job["description_text"] or ""
                if not desc.strip():
                    continue

                extracted = extract_title_company_location_from_description(desc)
                title_hint = extracted.get("title")

                # parse salary/workplace
                smin, smax, period = parse_salary_range(desc)
                workplace = parse_workplace_type(desc)

                # infer experience (more conservative; returns None if uncertain)
                exp_level = infer_experience_level(desc, title_hint=title_hint)

                # upsert dimensions if missing
                company_id = job["company_id"]
                existing_company_name = job.get("existing_company_name") if isinstance(job, dict) else None
                if company_id and existing_company_name and is_bad_company_name(existing_company_name):
                    company_id = None

                if (not company_id) and extracted["company"]:
                    company_id = upsert_company(cur, extracted["company"])

                role_id = job["role_id"]
                if (not role_id) and extracted["title"]:
                    role_id = upsert_role(cur, extracted["title"])

                location_id = job["location_id"]
                if (not location_id) and extracted["location"]:
                    location_id = upsert_location(
                        cur, extracted["location"], extracted["state"]
                    )

                # update job_postings only for fields we actually found / inferred
                fields = []
                params = []

                if company_id and company_id != job["company_id"]:
                    fields.append("company_id=%s")
                    params.append(company_id)
                if role_id and role_id != job["role_id"]:
                    fields.append("role_id=%s")
                    params.append(role_id)
                if location_id and location_id != job["location_id"]:
                    fields.append("location_id=%s")
                    params.append(location_id)

                if workplace and workplace != job["workplace_type"]:
                    fields.append("workplace_type=%s")
                    params.append(workplace)

                if smin is not None and smin != job["salary_min"]:
                    fields.append("salary_min=%s")
                    params.append(smin)
                if smax is not None and smax != job["salary_max"]:
                    fields.append("salary_max=%s")
                    params.append(smax)
                if period is not None and period != job["salary_period"]:
                    fields.append("salary_period=%s")
                    params.append(period)

                if exp_level is not None and exp_level != job["experience_level"]:
                    fields.append("experience_level=%s")
                    params.append(exp_level)

                if fields:
                    params.append(job_id)
                    cur.execute(
                        f"UPDATE job_postings SET {', '.join(fields)} WHERE job_id=%s",
                        tuple(params),
                    )
                    updated_jobs += 1
                    print(f"Updated {job_id}: {', '.join([f.split('=')[0] for f in fields])}")

                # skill extraction + priority classification + insert/update
                skill_priority_map = extract_skill_priorities(desc, compiled_patterns)
                # NEW: capture candidate skills + soft skills
                record_skill_candidates(cur, job_id, desc, compiled_patterns)
                ins, upd = insert_or_update_job_skills(cur, job_id, skill_priority_map)
                if ins:
                    inserted_job_skills += ins
                    print(f"Inserted {ins} job_skills rows for {job_id}")
                if upd:
                    updated_job_skills += upd
                    print(f"Upgraded {upd} job_skills priorities for {job_id}")

            conn.commit()
            print("\nDone.")
            print(f"Updated job_postings rows: {updated_jobs}")
            print(f"Inserted job_skills rows: {inserted_job_skills}")
            print(f"Updated (upgraded) job_skills rows: {updated_job_skills}")

    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


if __name__ == "__main__":
    main()

