def infer_role_archetype(title: str) -> Optional[str]:
    t = title.lower()
    if "business intelligence" in t or re.search(r"\bbi\b", t):
        return "bi_analytics"
    if (
        "sales ops" in t
        or "sales operations" in t
        or "revops" in t
        or "revenue ops" in t
    ):
        return "sales_operations"
    if "product" in t or "growth" in t or "experiment" in t:
        return "product_analytics"
    if "strategy" in t or "strategic" in t:
        return "strategy"
    if "data engineer" in t or "analytics engineer" in t:
        return "data_engineering"
    if "data analyst" in t or "analyst" in t:
        return "general_analytics"
    return None


# -----------------------------
# Experience level inference (more reliable, less guessing)
# -----------------------------


def _extract_years_experience_requirements(desc: str) -> Optional[int]:
    """
    Extract a conservative 'minimum years of experience' signal.
    We ONLY count a years pattern if it's tied to experience context.
    Returns minimum years (int) or None.
    """
    lines = [clean_text(x) for x in desc.splitlines()]
    lines = [x for x in lines if x]
    dash = r"(?:-|–|—)"

    # We'll scan lines that mention both year(s) and experience.
    candidates: List[int] = []

    for line in lines:
        l = normalize_for_matching(line)
        if "year" not in l or "experience" not in l:
            continue

        # patterns like "3+ years of experience"
        m_plus = re.search(r"\b(\d+)\s*\+\s*years?\b", l)
        if m_plus and re.search(r"\byears?\b.*\bexperience\b|\bexperience\b.*\byears?\b", l):
            candidates.append(int(m_plus.group(1)))
            continue

        # patterns like "3-5 years of experience" or "3 to 5 years experience"
        m_range = re.search(rf"\b(\d+)\s*(?:{dash}|to)\s*(\d+)\s*years?\b", l)
        if m_range and re.search(r"\byears?\b.*\bexperience\b|\bexperience\b.*\byears?\b", l):
            lo = int(m_range.group(1))
            # Use the lower bound (minimum requirement) for conservatism
            candidates.append(lo)
            continue

        # patterns like "at least 2 years experience"
        m_atleast = re.search(r"\b(at\s*least|min(?:imum)?)\s*(\d+)\s*years?\b", l)
        if m_atleast and "experience" in l:
            candidates.append(int(m_atleast.group(2)))
            continue

        # patterns like "2 years of related experience"
        m_plain = re.search(r"\b(\d+)\s*years?\b", l)
        if m_plain and re.search(r"\bof\b.*\bexperience\b|\bexperience\b", l):
            candidates.append(int(m_plain.group(1)))
            continue

    if not candidates:
        return None

    # Most conservative: minimum observed
    return min(candidates)


def infer_experience_level(desc: str, title_hint: Optional[str] = None) -> Optional[str]:
    """
    More reliable, less guessy:
      1) Trust explicit seniority in the TITLE first (best signal).
      2) Then look for explicit level words in the text (but avoid false matches).
      3) Then infer from years ONLY when explicitly tied to "experience" context.
      4) If no strong signal, return None (unknown) rather than guessing.

    Levels: entry, associate, mid, senior
    """
    # 1) Title-based seniority (strongest / least ambiguous)
    if title_hint:
        tt = normalize_for_matching(title_hint)
        if re.search(r"\b(senior|sr\.?)\b", tt):
            return "senior"
        if re.search(r"\b(lead|principal|staff)\b", tt):
            # You can map these differently later; for now treat as senior signal.
            return "senior"
        if re.search(r"\b(mid[- ]level|mid level)\b", tt):
            return "mid"
        if re.search(r"\b(associate)\b", tt):
            return "associate"
        if re.search(r"\b(entry[- ]level|entry level|junior|jr\.?)\b", tt):
            return "entry"
        if re.search(r"\b(intern|internship)\b", tt):
            return "entry"

    t = normalize_for_matching(desc)

    # 2) Explicit keywords in text, but require context to reduce false positives.
    # Example: "senior leadership" appears in many postings even if role isn't senior.
    # We'll accept "senior" only if near role words or "position"/"role"/"level".
    explicit_checks = [
        (r"\b(senior|sr\.?)\b", "senior"),
        (r"\b(mid[- ]level|mid level)\b", "mid"),
        (r"\bassociate\b", "associate"),
        (r"\b(entry[- ]level|entry level|junior|jr\.?)\b", "entry"),
    ]

    def _contextual_hit(pat: str, text: str, window: int = 40) -> bool:
        for m in re.finditer(pat, text):
            start = max(0, m.start() - window)
            end = min(len(text), m.end() + window)
            ctx = text[start:end]
            if re.search(r"\b(role|position|level|title|candidate|opening|opportunity)\b", ctx):
                return True
            # also allow if "senior data analyst" style appears in ctx
            if _TITLE_KEYWORDS_RE.search(ctx):
                return True
        return False

    for pat, lvl in explicit_checks:
        if _contextual_hit(pat, t):
            return lvl

    # 3) Years-based inference ONLY when tied to experience context
    min_years = _extract_years_experience_requirements(desc)
    if min_years is None:
        return None

    # Conservative mapping (your earlier spec, but only when years are truly "experience years")
    if min_years >= 5:
        return "senior"
    if min_years >= 3:
        return "mid"
    if min_years >= 1:
        return "associate"
    if min_years == 0:
        return "entry"

    return None


