def is_bad_company_name(name: str) -> bool:
    if not name:
        return True
    norm = normalize_company_candidate(name)
    if not norm:
        return True
    if _BAD_COMPANY_TOKEN_RE.search(norm):
        return True
    if norm in {"full time", "part time", "contract", "temporary", "internship", "remote", "hybrid", "on site", "in office"}:
        return True
    return False

def score_company_candidate(raw_line: str) -> int:
    """Higher score = more likely a real company name."""
    s = clean_text(raw_line)
    # LinkedIn artifact: 'Company logo'
    s = re.sub(r"\s+logo$", "", s, flags=re.IGNORECASE).strip()
    if not s:
        return -999

    # hard rejects
    if is_bad_company_name(s):
        return -80
    if len(s) < 3 or len(s) > 70:
        return -30
    if re.fullmatch(r"[\d\W_]+", s):
        return -80
    if re.search(r"\b[A-Za-z .\x27-]+,\s*[A-Z]{2}\b", s):
        return -40
    if "$" in s:
        return -60

    words = [w for w in re.split(r"\s+", s) if w]
    wc = len(words)

    score = 0

    # prefer plausible word counts
    if 1 <= wc <= 6:
        score += 10
    else:
        score -= 10

    # corporate suffixes are strong signal
    if _COMPANY_SUFFIX_RE.search(s):
        score += 14

    # Title Case-ish signal
    titlecase_words = sum(1 for w in words if w[:1].isupper())
    if titlecase_words >= max(1, wc // 2):
        score += 6

    # penalties
    if re.search(r"\d", s):
        score -= 6
    if re.search(r"[/:;]", s):
        score -= 6
    if wc == 1 and "-" in s:
        score -= 6

    return score



def _split_linkedin_line(line: str) -> str:
    """
    LinkedIn often uses separators like "Company · Location · Reposted".
    Keep the first segment as a candidate.
    """
    s = line.strip()
    # LinkedIn copy/paste artifact: 'Company logo'
    s = re.sub(r"\s+logo$", "", s, flags=re.IGNORECASE).strip()
    # Common separators in copy/paste: · • |
    for sep in [" · ", " • ", " | "]:
        if sep in s:
            s = s.split(sep, 1)[0].strip()
            break
    return s


def extract_title_company_location_from_description(
    desc: str,
) -> Dict[str, Optional[str]]:
    lines = [clean_text(x) for x in desc.splitlines()]
    lines = [x for x in lines if x]
    top = lines[:35]

    # location: "Seattle, WA" or fallback "United States"
    location = None
    state = None
    for line in top:
        m = re.search(r"\b([A-Za-z .'-]+),\s*([A-Z]{2})\b", line)
        if m:
            location = m.group(1).strip()
            state = m.group(2).strip()
            break

    if not location:
        for line in top:
            if re.search(r"\bUnited States\b", line, flags=re.IGNORECASE):
                location = "United States"
                state = None
                break

    # title: take first strong-looking line that contains a role keyword
    title = None
    for line in top:
        low = line.lower()
        if _TITLE_KEYWORDS_RE.search(line):
            if any(bad in low for bad in ["job alert", "reposted", "clicked apply", "promoted"]):
                continue
            if low.strip() == "apply":
                continue
            title = line.strip(" -•")
            break

    # company: score candidates and only accept if a good candidate exists
    company = None
    best_company = None
    best_score = -999

    for raw_line in top[:15]:
        line = _split_linkedin_line(raw_line)
        if not line:
            continue

        # Fast rejects (cheap)
        if title and line == title:
            continue
        if _TITLE_KEYWORDS_RE.search(line):
            continue
        if re.search(r"\b[A-Za-z .'-]+,\s*[A-Z]{2}\b", line):
            continue

        sc = score_company_candidate(line)
        if sc > best_score:
            best_score = sc
            best_company = line.strip(" -•")

    # Threshold: accept only if it looks legit; otherwise keep NULL
    company = best_company if (best_company and best_score >= 10) else None

    return {"title": title, "company": company, "location": location, "state": state}



