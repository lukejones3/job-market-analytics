# -----------------------------
# Text normalization
# -----------------------------


def clean_text(s: str) -> str:
    # Normalize common weird LinkedIn copy/paste artifacts
    s = s.replace("\u00a0", " ")
    # collapse whitespace
    s = re.sub(r"[ \t]+", " ", s)
    return s.strip()


def normalize_for_matching(s: str) -> str:
    s = s.lower().replace("\u00a0", " ")
    s = re.sub(r"\s+", " ", s)
    return s.strip()


def normalize_company_candidate(s: str) -> str:
    s = s.lower().replace("\u00a0", " ")

    # Normalize ALL dash variants → space
    s = re.sub(r"[\u2010\u2011\u2012\u2013\u2014\u2015\-]", " ", s)

    # Collapse whitespace
    s = re.sub(r"\s+", " ", s)

    return s.strip()


# -----------------------------
# Workplace + Salary parsing
# -----------------------------


def parse_workplace_type(text: str) -> Optional[str]:
    """
    Priority: hybrid > remote > onsite
    (LinkedIn often contains both "hybrid/remote"; hybrid is usually more specific.)
    """
    t = text.lower()
    if re.search(r"\bhybrid\b", t):
        return "hybrid"
    if re.search(r"\bremote\b", t):
        return "remote"
    if re.search(r"\bon[- ]?site\b|\bonsite\b|\bin office\b", t):
        return "onsite"
    return None


def _money_to_number(x: str) -> Optional[Decimal]:
    x = x.strip().replace(",", "").replace("$", "")
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([kKmM]?)", x)
    if not m:
        return None
    val = Decimal(m.group(1))
    suffix = m.group(2).lower()
    if suffix == "k":
        val *= 1000
    elif suffix == "m":
        val *= 1000000
    return val


def _infer_period_from_context(text: str, start: int, end: int) -> Optional[str]:
    """
    Try to infer period (year/hour/month) from nearby context around a detected salary range.
    """
    window = text[max(0, start - 80) : min(len(text), end + 80)].lower()
    if re.search(r"\b(per\s*year|/yr|yearly|annually|annual)\b", window):
        return "year"
    if re.search(r"\b(per\s*hour|/hr|hourly)\b", window):
        return "hour"
    if re.search(r"\b(per\s*month|/mo|monthly)\b", window):
        return "month"
    return None


def parse_salary_range(
    text: str,
) -> Tuple[Optional[Decimal], Optional[Decimal], Optional[str]]:
    """
    Tries common formats:
      "$81.6K/yr - $102K/yr"
      "Annual base salary range $81,600 - 102,000"
      "$55,000 - $160,000"
    Returns (min, max, period) where period in {"year","hour","month"} or None.
    """
    t = clean_text(text)
    dash = r"(?:-|–|—)"  # accept hyphen/en-dash/em-dash

    # 1) $81.6K/yr - $102K/yr
    m = re.search(
        rf"\$?\s*(\d+(?:\.\d+)?[kKmM]?)\s*/\s*(yr|year|hr|hour|mo|month)\s*{dash}\s*\$?\s*(\d+(?:\.\d+)?[kKmM]?)\s*/\s*(yr|year|hr|hour|mo|month)",
        t,
        flags=re.IGNORECASE,
    )
    if m:
        s1, p1, s2, p2 = m.group(1), m.group(2).lower(), m.group(3), m.group(4).lower()

        # harden: both periods should match
        def _p_norm(p: str) -> str:
            if p.startswith("y"):
                return "year"
            if p.startswith("h"):
                return "hour"
            return "month"

        p1n = _p_norm(p1)
        p2n = _p_norm(p2)
        if p1n != p2n:
            return None, None, None

        return _money_to_number(s1), _money_to_number(s2), p1n

    # 2) Annual base salary range $81,600 - 102,000
    m = re.search(
        rf"(annual\s+base\s+salary\s+range|base\s+pay\s+range|salary\s+range)\s*\$?\s*([\d,]+(?:\.\d+)?)\s*{dash}\s*\$?\s*([\d,]+(?:\.\d+)?)",
        t,
        flags=re.IGNORECASE,
    )
    if m:
        return _money_to_number(m.group(2)), _money_to_number(m.group(3)), "year"

    # 3) Generic salary ranges MUST look like money, not "1-2 years"
    # Require at least one of:
    #   - a $ sign
    #   - a K/M suffix
    #   - salary-ish words nearby
    m = re.search(
        rf"(?i)(salary|compensation|pay|base)\D{{0,40}}(\$?\s*[\d,]+(?:\.\d+)?[kKmM]?)\s*{dash}\s*\$?\s*([\d,]+(?:\.\d+)?[kKmM]?)"
        rf"|(\$\s*[\d,]+(?:\.\d+)?[kKmM]?)\s*{dash}\s*(\$\s*[\d,]+(?:\.\d+)?[kKmM]?)",
        t,
    )
    if m:
        if m.group(2) and m.group(3):
            smin = _money_to_number(m.group(2))
            smax = _money_to_number(m.group(3))
            period = _infer_period_from_context(t, m.start(), m.end())
            return smin, smax, period
        if m.group(4) and m.group(5):
            smin = _money_to_number(m.group(4))
            smax = _money_to_number(m.group(5))
            period = _infer_period_from_context(t, m.start(), m.end())
            return smin, smax, period

    return None, None, None


