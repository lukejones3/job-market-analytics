def insert_or_update_job_skills(
    cur, job_id: str, skill_priority_map: Dict[str, str]
) -> Tuple[int, int]:
    """
    Upgrades priorities when we find a stronger signal later:
      required > preferred > nice-to-have
    """
    if not skill_priority_map:
        return 0, 0

    priority_rank = {"required": 3, "preferred": 2, "nice-to-have": 1}

    cur.execute(
        "SELECT skill_id, skill_priority FROM job_skills WHERE job_id=%s", (job_id,)
    )
    existing_rows = cur.fetchall()

    existing: Dict[str, Optional[str]] = {}
    for r in existing_rows:
        sid = r[0] if not isinstance(r, dict) else r["skill_id"]
        pri = r[1] if not isinstance(r, dict) else r["skill_priority"]
        existing[sid] = pri

    inserted = 0
    updated = 0

    for sid, pri in skill_priority_map.items():
        if sid not in existing:
            js_id = next_job_skill_id(cur)
            cur.execute(
                """
                INSERT INTO job_skills (job_skills_id, job_id, skill_id, skill_priority)
                VALUES (%s, %s, %s, %s)
                """,
                (js_id, job_id, sid, pri),
            )
            inserted += 1
        else:
            cur_pri = (existing.get(sid) or "").strip() if existing.get(sid) else ""
            if priority_rank.get(pri, 0) > priority_rank.get(cur_pri, 0):
                cur.execute(
                    """
                    UPDATE job_skills
                    SET skill_priority=%s
                    WHERE job_id=%s AND skill_id=%s
                    """,
                    (pri, job_id, sid),
                )
                updated += 1

    return inserted, updated


