# Reject EEO/boilerplate and protected-class words (not skills)
# Hard rejects: EEO/protected-class boilerplate + common geo fragments + generic junk
_CANDIDATE_HARD_REJECT_RE = re.compile(
    r"\b("
    r"equal employment|eeo|affirmative action|protected class|"
    r"race|color|religion|sex|gender|pregnan|national origin|disabilit|veteran|genetic|"
    r"age over 40|sexual orientation|marital status|"
    r")\b",
    flags=re.IGNORECASE
)

_CANDIDATE_STRICT_REJECT_RE = re.compile(
    r"(?i)\b("
    r"equal opportunity|eeo|accommodation|drug[- ]?free|background check|"
    r"race|color|religion|creed|sex|gender|pregnancy|marital status|"
    r"national origin|sexual orientation|genetic information|ancestry|disability|veteran"
    r")\b"
)

def _looks_like_tool_or_hard_skill(raw: str, norm: str) -> bool:
    # v3: hard rejects (EEO/protected-class boilerplate)
    if _CANDIDATE_HARD_REJECT_RE.search(norm):
        return False

    # v3: reject 2-letter tokens (IL/CA/etc)
    if re.fullmatch(r"[a-z]{2}", norm):
        return False

    # v3: reject common country tokens
    if re.fullmatch(r"(usa|us|u\.s\.|china|japan|india|canada|uk)", norm):
        return False

    # v3: reject 'X skills' artifact
    if norm.endswith(" skills"):
        return False

    # length gates
    if len(norm) < 2 or len(norm) > 40:
        return False

    # word-count gate (kills sentences)
    if len(norm.split()) > 4:
        return False

    # kill sentence fragments / boilerplate labels
    if "." in raw or ";" in raw:
        return False
    if norm.startswith(("and ", "with ", "including ")):
        return False
    if any(k in norm for k in ("requirement", "qualification", "opportunit", "benefit")):
        return False

    if norm in _CANDIDATE_STRICT_GATES:
        return False
    if _CANDIDATE_STRICT_REJECT_RE.search(norm):
        return False

    # obvious tool-ish signals
    if re.fullmatch(r"[a-z]{2,10}\d{0,2}", norm):   # acronyms like sql, ga4, dbt, jira
        return True
    if any(ch in raw for ch in "+/&.-"):            # C++, A/B, Power-BI, etc.
        return True
    if any(ch.isdigit() for ch in raw):             # GA4, ISO27001, etc.
        return True
    # TitleCase / CamelCase signal
    raw_str = raw.strip()
    if raw_str[:1].isupper() and any(c.isupper() for c in raw_str[1:]):
        return True

    # allow a tiny curated set of hard-skill nouns (keep small!)
    allow = {"statistics","forecasting","modeling","regression","etl","api","dashboarding","visualization"}
    # allow common lowercase tool/platform names that often appear un-capitalized in postings
    TOOL_ALLOW = {
        "snowflake","databricks","airflow","dbt","redshift","bigquery","bigquery","big table",
        "hadoop","spark","pyspark","kafka","docker","kubernetes","terraform",
        "gitlab","github","bitbucket","jira","confluence",
        "sagemaker","athena","glue","lambda","ec2","s3",
        "fivetran","stitch","segment","mixpanel",
        "looker","lookml","superset","metabase",
        "hyperion","netsuite","workday","adaptive","anaplan","servicenow",
        "postgres","postgresql","mysql","mssql","sqlserver","oracle",
    }

    # reject generic filler nouns that show up everywhere (avoid flooding candidates)
    GENERIC_BLOCK = {
        "financial","management","integrity","passion","confidence","hungry","connect",
        "education","learning","knowledge","clients","training","retirement","benefits",
        "salary","compensation","skills","requirements","qualifications"
    }

    if norm in allow:
        return True

    # Accept well-formed lowercase tool names in skill-ish lines
    if norm in TOOL_ALLOW:
        return True

    # Accept single-token lowercase strings that look like tools (letters/digits/./+/#),
    # but only if they are not generic filler.
    if norm not in GENERIC_BLOCK and re.fullmatch(r"[a-z][a-z0-9\.\+\#\-]{2,30}", norm):
        return True

    return False


def record_skill_candidates(cur, job_id: str, desc: str, compiled_patterns):
    """
    Extract candidate skills from likely sections/lines and upsert into skill_candidates.
    Avoid candidates that already match canonical alias patterns.
    Also writes soft skills into job_soft_skills.
    """
    # build ignore set from aliases that actually match this description
    ignore = set()
    t_all = normalize_for_matching(desc)
    for pat, _sid, alias in compiled_patterns:
        if pat.search(t_all):
            ignore.add(_norm_candidate(alias))

    lines = [clean_text(x) for x in desc.splitlines()]
    lines = [x for x in lines if x]


    in_excluded_section = False
    # --- LAST5_PATCH_v1 ---
    # Keep only useful acronyms (otherwise TSA/FBI/etc noise floods candidates)
    ACRONYM_ALLOW = {
        "bi","kpi","etl","elt","api","erp","hris","wfm","ga4","seo","ppc","cro",
        "ml","ai","nlp","aws","gcp","git","pca","glm","dax","json","sql","ui","ux"
    }
    ACRONYM_BLOCK = {"tsa","fbi","eeo","ada","doi","eod","eom"}



    # --- LASTMILE_PATCH_v1 ---
    STATES_BLOCK = {
        'alabama',
        'alaska',
        'arizona',
        'arkansas',
        'california',
        'colorado',
        'connecticut',
        'delaware',
        'florida',
        'georgia',
        'hawaii',
        'idaho',
        'illinois',
        'indiana',
        'iowa',
        'kansas',
        'kentucky',
        'louisiana',
        'maine',
        'maryland',
        'massachusetts',
        'michigan',
        'minnesota',
        'mississippi',
        'missouri',
        'montana',
        'nebraska',
        'nevada',
        'new hampshire',
        'new jersey',
        'new mexico',
        'new york',
        'north carolina',
        'north dakota',
        'ohio',
        'oklahoma',
        'oregon',
        'pennsylvania',
        'rhode island',
        'south carolina',
        'south dakota',
        'tennessee',
        'texas',
        'utah',
        'vermont',
        'virginia',
        'washington',
        'west virginia',
        'wisconsin',
        'wyoming'
    }
    BRAND_BLOCK = {
        'skyscanner',
        'ryanair',
        'flipkart',
        'wayfair',
        'backstage',
        'lancaster',
        'sargent-disc'
    }


    STOP_PHRASES = {
        # boilerplate fragments
        "but not limited to","and abilities","additional skills & qualifications",
        "industry requirements","requirements gathering","geographic location",
        "non-technical audiences","and real-world application",
        "working with over","hands-on collaborators",
        # generic fluff
        "strong analytical","excellent communication","written",
        "execution","passion","collect","develop","formulate","analyze",
    }
    # detect and skip entire EEO/benefits/legal sections
    def _toggle_excluded(line_norm: str) -> bool:
        # Start excluded if header matches and NOT immediately a skills header
        if _EXCLUDED_SECTION_HEADERS_RE.search(line_norm) and not re.search(r"(?i)\b(qualifications|requirements|skills)\b", line_norm):
            return True
        return False

    # Focus on likely skill-heavy lines
    skillish_lines = []
    for ln in lines[:300]:  # cap to avoid insane scans
        low = normalize_for_matching(ln)
        # enter excluded section
        if _toggle_excluded(low):
            in_excluded_section = True
        # exit excluded section if we hit a major new header
        if in_excluded_section and _END_SECTION_RE.search(low) and not _EXCLUDED_SECTION_HEADERS_RE.search(low):
            in_excluded_section = False
        if in_excluded_section:
            continue

        if any(k in low for k in ["requirements", "qualifications", "skills", "preferred", "must have", "nice to have", "tools", "tech", "stack", "technology"]):
            skillish_lines.append(ln)
            continue
        if ln.strip().startswith(("-", "•")):
            skillish_lines.append(ln)
            continue

    for ln in skillish_lines:
        # derive a light context confidence
        pri = detect_priority_from_line(ln) or infer_section_priority(ln) or "required"
        base_conf = 0.80 if pri == "required" else (0.60 if pri == "preferred" else 0.45)

        for raw, norm in _extract_candidate_phrases_from_line(ln):
            # tool gate temporarily disabled (was too strict)
            if norm in ignore:
                continue

            # extra filters: strip generic / legal / geo junk
            if re.fullmatch(r"[a-z]{1,2}", norm):  # il/ca/etc
                continue
            if re.fullmatch(r"(yes|no|and|or|the|a|an|our|your|their|you|we)", norm):
                continue
            if re.fullmatch(r"(education|learning|knowledge|clients|training|retirement|benefits|salary|compensation)", norm):
                continue
            if re.fullmatch(r"(gender|religion|race|creed|pregnancy|ancestry|marital status|national origin|sexual orientation|genetic information)", norm):
                continue
            if re.fullmatch(r"(usa|us|u\.s\.|china|japan|india|canada|uk)", norm):
                continue
            if norm.startswith("age over"):
                continue
            if norm.endswith(" skills"):
                continue

            # acronym rules (avoid TSA/FBI/etc)
            # --- LAST MILE FILTERS ---
            # kill US state names + obvious brands
            if norm in STATES_BLOCK:
                continue
            if norm in BRAND_BLOCK:
                continue

            # kill domain-like tokens (booking.com, etc) unless TOOL_ALLOW later accepts them
            if re.search(r"\b[a-z0-9-]+\.(com|io|ai|net|org)\b", raw.lower()):
                continue

            # kill category/header fragments
            if norm.startswith("category:"):
                continue

            # kill slash boilerplate
            if norm in ("qualifications/requirements", "skills/abilities"):
                continue
            # also kill any "x/y" where both sides are generic headers
            if "/" in norm:
                left, right = [x.strip() for x in norm.split("/", 1)]
                if left in {"skills","skill","qualification","qualifications","requirement","requirements","abilities"} \
                   and right in {"skills","skill","qualification","qualifications","requirement","requirements","abilities"}:
                    continue
            # --- END LAST MILE FILTERS ---

            if re.fullmatch(r"[a-z]{2,6}\d{0,2}", norm):
                if norm in ACRONYM_BLOCK:
                    continue
                if norm not in ACRONYM_ALLOW:
                    continue


            # --- SMART ACCEPTANCE GATE ---
            # Reject anything with digits (almost always junk fragments)
            if re.search(r"\d", norm):
                continue

            # Normalize a few boilerplate prefixes
            if norm.startswith(("and ", "or ", "with ", "to ")):
                continue

            if norm in STOP_PHRASES:
                continue

            # Allowlist acronyms/tools first
            if re.fullmatch(r"[a-z]{2,6}\d{0,2}", norm):
                if norm in ACRONYM_BLOCK:
                    continue
                if norm not in ACRONYM_ALLOW:
                    continue
                # allowed acronym passes
            else:
                # Non-acronyms must look skill/tool-like
                raw_str = raw.strip()

                toolish_char = bool(re.search(r"[\/\+\#\.]", raw_str))
                # TitleCase alone creates brand noise (Wayfair/Flipkart/etc).
                # Only treat as 'tool-like' if CamelCase (internal capital) OR passes tool checks.
                titlecaseish = raw_str[:1].isupper() and any(c.isupper() for c in raw_str[1:])
                multiword = (" " in norm)

                # kill ultra-generic single words
                if not multiword and len(norm) < 4:
                    continue

                generic_single = {
                    "written","execution","develop","collect","formulate","analyze",
                    "passion","knowledge","education","learning","clients","training",
                    "retirement","benefits","salary","compensation"
                }
                if not multiword and norm in generic_single:
                    continue

                # allow known tools (from TOOL_ALLOW in _looks_like_tool_or_hard_skill)
                if not (toolish_char or titlecaseish or multiword or _looks_like_tool_or_hard_skill(raw_str, norm)):
                    continue

                # allow certain multiword endings that are usually real skills
                if multiword and not (
                    norm.endswith(("modeling","forecasting","regression","machine learning","data engineering","data analytics"))
                    or "analysis" in norm
                    or "etl" in norm
                    or "dashboard" in norm
                ):
                    # still let it pass if it looks like a tool
                    if not _looks_like_tool_or_hard_skill(raw_str, norm):
                        continue
            # --- END SMART ACCEPTANCE GATE ---

            is_soft = _looks_like_soft_skill(norm)
            skill_type_guess = "soft" if is_soft else "hard"

            # simple tweak: acronyms are often genuine hard skills/tools
            if re.fullmatch(r"[a-z]{2,10}\d{0,2}", norm) and not is_soft:
                conf = min(0.95, base_conf + 0.10)
            else:
                conf = base_conf

            upsert_skill_candidate(cur, raw_text=raw, normalized_text=norm,
                                  skill_type_guess=skill_type_guess, confidence=float(conf),
                                  sample_job_id=job_id)

            if is_soft:
                insert_soft_skill(cur, job_id, soft_skill=raw, normalized_text=norm,
                                  confidence=float(conf), src="regex")



def build_alias_pattern(alias_text: str) -> re.Pattern:
    a = alias_text.strip().lower()
    esc = re.escape(a)
    esc = esc.replace(r"\ ", r"\s*")
    esc = esc.replace(r"\/", r"\s*/\s*")
    esc = esc.replace(r"\-", r"\s*-\s*")

    prefix = r"\b" if re.match(r"^[a-z0-9]", a) else ""
    suffix = r"\b" if re.match(r".*[a-z0-9]$", a) else ""
    pattern = prefix + esc + suffix
    return re.compile(pattern, flags=re.IGNORECASE)


def load_skill_alias_patterns(cur) -> List[Tuple[re.Pattern, str, str]]:
    cur.execute("SELECT alias_text, skill_id FROM skill_aliases")
    rows = cur.fetchall()

    compiled: List[Tuple[re.Pattern, str, str]] = []
    for r in rows:
        alias_text = (r["alias_text"] if isinstance(r, dict) else r[0]) or ""
        skill_id = (r["skill_id"] if isinstance(r, dict) else r[1]) or ""
        alias_text = alias_text.strip().lower()
        if not alias_text or not skill_id:
            continue
        compiled.append((build_alias_pattern(alias_text), skill_id, alias_text))

    # Longest alias first to reduce partial matches stealing the hit
    compiled.sort(key=lambda x: len(x[2]), reverse=True)
    return compiled


def detect_priority_from_line(line: str) -> Optional[str]:
    l = normalize_for_matching(line)

    if re.search(r"\b(nice to have|nice-to-have|bonus|a plus|good to have)\b", l):
        return "nice-to-have"
    if re.search(r"\b(preferred|preferably|would be great|plus if)\b", l):
        return "preferred"
    if re.search(r"\b(required|must have|must-have|need to have)\b", l):
        return "required"
    return None


def infer_section_priority(header_line: str) -> Optional[str]:
    l = normalize_for_matching(header_line)

    if re.search(r"\b(nice to have|nice-to-have|bonus|additional)\b", l):
        return "nice-to-have"
    if re.search(r"\b(preferred qualifications|preferred)\b", l):
        return "preferred"
    if re.search(r"\b(requirements|required qualifications|must have)\b", l):
        return "required"
    if re.search(r"\b(qualifications|what you will have|what you'll have)\b", l):
        return "required"
    return None


