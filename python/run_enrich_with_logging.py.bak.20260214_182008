from snapshots import write_monthly_skill_snapshot
from dotenv import load_dotenv
load_dotenv()
import sys
from typing import Optional
import os
import re
import uuid
import subprocess
from datetime import datetime
import psycopg2
from psycopg2.extras import DictCursor
ENRICH_SCRIPT = os.path.join("python", "enrich_job_postings.py")
# This should match the "jobs selection" logic from your enrich script as closely as possible.
JOBS_SEEN_SQL = """
SELECT COUNT(DISTINCT jp.job_id) AS n
FROM job_postings jp
LEFT JOIN job_skills js ON js.job_id = jp.job_id
WHERE jp.description_text IS NOT NULL
  AND (
        jp.company_id IS NULL
     OR jp.role_id IS NULL
     OR jp.location_id IS NULL
     OR jp.workplace_type IS NULL
     OR jp.salary_min IS NULL
     OR jp.salary_max IS NULL
     OR jp.salary_period IS NULL
     OR jp.experience_level IS NULL
     OR js.job_id IS NULL
  );
"""
def get_conn():
    return psycopg2.connect(
        host=os.getenv("PGHOST", "localhost"),
        port=int(os.getenv("PGPORT", "5432")),
        dbname=os.getenv("PGDATABASE", "job_analytics"),
        user=os.getenv("PGUSER"),
        password=os.getenv("PGPASSWORD"),
    )
def new_run_id() -> str:
    return "RUN_" + datetime.now().strftime("%Y%m%d_%H%M%S") + "_" + uuid.uuid4().hex[:6]
def log_run_start(cur, run_id: str, jobs_seen: int) -> None:
    cur.execute(
        """
        INSERT INTO pipeline_runs (run_id, started_at, status, jobs_seen, jobs_updated, skills_inserted, errors_count)
        VALUES (%s, NOW(), 'running', %s, 0, 0, 0)
        """,
        (run_id, jobs_seen),
    )
def log_run_failed(cur, run_id: str, jobs_updated: int, skills_inserted: int, errors_count: int) -> None:
    cur.execute(
        """
        UPDATE pipeline_runs
        SET finished_at = NOW(),
            status = 'failed',
            jobs_updated = %s,
            skills_inserted = %s,
            errors_count = %s
        WHERE run_id = %s
        """,
        (jobs_updated, skills_inserted, errors_count, run_id),
    )
def log_pipeline_error(cur, run_id: str, job_id: Optional[str], stage: str, error_message: str) -> None:
    cur.execute(
        """
        INSERT INTO pipeline_errors (run_id, job_id, stage, error_message, created_at)
        VALUES (%s, %s, %s, %s, NOW())
        """,
        (run_id, job_id, stage, (error_message or "")[:2000]),
    )
def parse_counts(stdout: str) -> tuple[int, int, int]:
    """
    Parse your enrich stdout. Expected lines like:
      Updated job_postings rows: 1
      Inserted job_skills rows: 8
      Updated job_skills rows: 0
    """
    upd_jobs = 0
    ins_skills = 0
    upd_skills = 0
    m = re.search(r"Updated job_postings rows:\s*(\d+)", stdout)
    if m:
        upd_jobs = int(m.group(1))
    m = re.search(r"Inserted job_skills rows:\s*(\d+)", stdout)
    if m:
        ins_skills = int(m.group(1))
    m = re.search(r"Updated\s*(?:\(upgraded\)\s*)?job_skills rows:\s*(\d+)", stdout)
    if m:
        upd_skills = int(m.group(1))
    return upd_jobs, ins_skills, upd_skills


def log_run_success(cur, run_id: str, jobs_updated: int, skills_inserted: int, errors_count: int) -> None:
    cur.execute(
        """
        UPDATE pipeline_runs
        SET finished_at = NOW(),
            status = 'success',
            jobs_updated = %s,
            skills_inserted = %s,
            errors_count = %s
        WHERE run_id = %s
        """,
        (jobs_updated, skills_inserted, errors_count, run_id),
    )

def main():
    if not os.path.exists(ENRICH_SCRIPT):
        raise FileNotFoundError(f"Enrich script not found: {ENRICH_SCRIPT}")
    conn = get_conn()
    conn.autocommit = False
    run_id = new_run_id()
    jobs_seen = 0
    jobs_updated = 0
    skills_inserted = 0
    errors_count = 0
    try:
        with conn.cursor(cursor_factory=DictCursor) as cur:
            # Ask enrich script how many jobs it would process (single source of truth)
            count_proc = subprocess.run(
                ["python3", ENRICH_SCRIPT, "--count-only"],
                capture_output=True,
                text=True,
            )
            if count_proc.returncode != 0:
                raise SystemExit(count_proc.returncode)
            try:
                jobs_seen = int((count_proc.stdout or "").strip().splitlines()[-1])
            except Exception:
                jobs_seen = 0
            log_run_start(cur, run_id, jobs_seen)
        # Run the actual enrich script
        proc = subprocess.run(
            [sys.executable, ENRICH_SCRIPT],
            capture_output=True,
            text=True
        )
        stdout = proc.stdout or ""
        stderr = proc.stderr or ""
        jobs_updated, skills_inserted, _upd_skills = parse_counts(stdout)
        if proc.returncode == 0:
            with conn.cursor(cursor_factory=DictCursor) as cur:
                log_run_success(cur, run_id, jobs_updated, skills_inserted, errors_count)
                # Write monthly skill-demand snapshot (post-enrich)
                snap_rows = write_monthly_skill_snapshot(cur, run_id)
            conn.commit()
            print(stdout, end="")
            print("[pipeline] monthly snapshot rows upserted={}".format(snap_rows))
            print(f"[pipeline] run_id={run_id} status=success jobs_seen={jobs_seen} jobs_updated={jobs_updated} skills_inserted={skills_inserted}")
        else:
            errors_count += 1
            with conn.cursor(cursor_factory=DictCursor) as cur:
                log_pipeline_error(cur, run_id, None, "run_crash", stderr or stdout or "unknown error")
                log_run_failed(cur, run_id, jobs_updated, skills_inserted, errors_count)
            print(stdout, end="")
            print(stderr, end="")
            raise SystemExit(proc.returncode)
    finally:
        conn.close()
if __name__ == "__main__":
    main()
