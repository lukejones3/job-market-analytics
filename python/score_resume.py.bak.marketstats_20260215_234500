SKILL_SECTION_HEADERS = [
    "skills", "technical skills", "tools", "technologies", "tech stack", "stack", "core competencies"
]

def extract_skill_sections(text: str) -> List[str]:
    """
    Pull lines after a skills header until the next blank gap/header-ish line.
    """
    lines = [clean_text(x) for x in text.splitlines()]
    out = []
    in_skills = False
    for ln in lines:
        low = normalize_for_matching(ln)
        if any(h == low or low.startswith(h + ":") for h in SKILL_SECTION_HEADERS):
            in_skills = True
            continue
        if in_skills:
            if low == "" or re.fullmatch(r"[A-Z \-/]{6,}", ln):  # crude “new section” signal
                in_skills = False
                continue
            out.append(ln)
    return out

def split_skill_list_line(line: str) -> List[str]:
    # Split on commas, pipes, bullets, slashes (careful w/ node.js)
    parts = re.split(r"[,\|•·\u2022]+", line)
    tokens = []
    for p in parts:
        p = clean_text(p)
        if not p:
            continue
        # explode "etl/elt" style
        if "/" in p and len(p) <= 30:
            for sub in p.split("/"):
                sub = clean_text(sub)
                if sub:
                    tokens.append(sub)
        else:
            tokens.append(p)
    return tokens

def resume_to_skills(cur, resume_id: str, resume_text: str, alias_patterns) -> int:
    """
    Writes to resume_skills. Returns count of unique skills found.
    Confidence sources:
      - alias regex hit in body: 0.92
      - list/section token exact match: 0.88
      - heuristic tool token (lowercase toolish): 0.78 (optional placeholder)
    """
    t_norm = normalize_for_matching(resume_text)

    # (A) alias hits anywhere in text
    found: Dict[str, Tuple[float, str, str]] = {}  # skill_id -> (conf, evidence, source)
    for pat, sid, alias in alias_patterns:
        m = pat.search(t_norm)
        if m:
            # evidence window (best effort)
            start = max(0, m.start() - 60)
            end = min(len(t_norm), m.end() + 60)
            evidence = t_norm[start:end]
            conf = 0.92
            found[sid] = (max(found.get(sid, (0, "", ""))[0], conf), evidence, "alias")

    # (B) skills section parsing (great for resumes)
    section_lines = extract_skill_sections(resume_text)
    for ln in section_lines:
        for tok in split_skill_list_line(ln):
            tok_norm = normalize_for_matching(tok)
            # exact alias text match -> map via skill_aliases table
            cur.execute("""
              SELECT skill_id FROM skill_aliases
              WHERE lower(alias_text) = %s
              LIMIT 1
            """, (tok_norm,))
            r = cur.fetchone()
            if r:
                sid = r["skill_id"]
                conf = 0.88
                evidence = tok
                prev = found.get(sid, (0, "", ""))
                if conf > prev[0]:
                    found[sid] = (conf, evidence, "section")

    # (C) Optional heuristic toolish tokens (placeholder)
    # This helps when alias coverage lags. Keeps confidence lower.
    # You can tighten later with allowlists.
    toolish = set()
    for ln in section_lines[:40]:
        for tok in split_skill_list_line(ln):
            tok_norm = normalize_for_matching(tok)
            if re.fullmatch(r"[a-z][a-z0-9\.\+\#\-]{2,30}", tok_norm):
                toolish.add(tok_norm)
    if toolish:
        cur.execute("""
          SELECT lower(alias_text) AS a, skill_id
          FROM skill_aliases
          WHERE lower(alias_text) = ANY(%s)
        """, (list(toolish),))
        for r in cur.fetchall():
            sid = r["skill_id"]
            conf = 0.78
            evidence = r["a"]
            prev = found.get(sid, (0, "", ""))
            if conf > prev[0]:
                found[sid] = (conf, evidence, "heuristic")

    # write to DB
    for sid, (conf, ev, src) in found.items():
        upsert_resume_skill(cur, resume_id, sid, ev or "", float(conf), src)

    return len(found)


