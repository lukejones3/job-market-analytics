    """, (resume_id, role_id, location_id, workplace_type, experience_level))

def upsert_resume_skill(cur, resume_id: str, skill_id: str, evidence: str, conf: float, source: str):
    cur.execute("""
      INSERT INTO resume_skills (resume_id, skill_id, evidence_text, confidence, source, updated_at)
      VALUES (%s, %s, %s, %s, %s, now())
      ON CONFLICT (resume_id, skill_id) DO UPDATE SET
        confidence = GREATEST(resume_skills.confidence, EXCLUDED.confidence),
        evidence_text = COALESCE(resume_skills.evidence_text, EXCLUDED.evidence_text),
        source = CASE
                  WHEN resume_skills.confidence >= EXCLUDED.confidence THEN resume_skills.source
                  ELSE EXCLUDED.source
                END,
        updated_at = now()
    """, (resume_id, skill_id, evidence[:4000] if evidence else None, float(conf), source))

