def fetch_skill_alias_patterns(cur) -> List[Tuple[re.Pattern, str, str]]:
    """
    Returns [(compiled_regex, skill_id, alias_text), ...]
    """
    cur.execute("""
      SELECT sa.alias_text, sa.skill_id
      FROM skill_aliases sa
      WHERE sa.alias_text IS NOT NULL AND btrim(sa.alias_text) <> ''
    """)
    rows = cur.fetchall()
    out = []
    for r in rows:
        alias = normalize_for_matching(r["alias_text"])
        # word-boundary-ish, but safe for tokens like "node.js" (don’t use \b blindly).
        pat = re.compile(rf"(?i)(^|[^a-z0-9])({re.escape(alias)})([^a-z0-9]|$)")
        out.append((pat, r["skill_id"], alias))
    return out

def upsert_resume(cur, resume_id: str, user_id: Optional[str], text: str, source: str, parse_version: str):
    t = clean_text(text)
    h = sha1_text(normalize_for_matching(t)) if t else None

    cur.execute("""
      INSERT INTO resumes (resume_id, user_id, resume_text, resume_hash, source, parse_version, status, updated_at)
      VALUES (%s, %s, %s, %s, %s, %s, 'parsed', now())
      ON CONFLICT (resume_id) DO UPDATE SET
        user_id = EXCLUDED.user_id,
        resume_text = EXCLUDED.resume_text,
        resume_hash = EXCLUDED.resume_hash,
        source = EXCLUDED.source,
        parse_version = EXCLUDED.parse_version,
        status = 'parsed',
        updated_at = now()
    """, (resume_id, user_id, t, h, source, parse_version))

