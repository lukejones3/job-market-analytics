def now_id(prefix: str) -> str:
    return f"{prefix}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"

def sha1_text(s: str) -> str:
    return hashlib.sha1(s.encode("utf-8", errors="ignore")).hexdigest()

def clean_text(s: str) -> str:
    s = s.replace("\u00a0", " ")
    s = re.sub(r"[ \t]+", " ", s)
    return s.strip()

def normalize_for_matching(s: str) -> str:
    s = s.lower().replace("\u00a0", " ")
    s = re.sub(r"\s+", " ", s)
    return s.strip()

def read_resume_file(path: Path) -> Tuple[str, str]:
    """
    Returns (text, source_type).
    """
    suffix = path.suffix.lower()
    if suffix == ".txt":
        return path.read_text(encoding="utf-8", errors="ignore"), "txt"

    if suffix == ".pdf":
        if pdfplumber is None:
            raise RuntimeError("pdfplumber not installed. pip install pdfplumber")
        parts = []
        with pdfplumber.open(str(path)) as pdf:
            for p in pdf.pages:
                t = p.extract_text() or ""
                parts.append(t)
        return "\n".join(parts), "pdf"

    if suffix in (".docx",):
        if docx is None:
            raise RuntimeError("python-docx not installed. pip install python-docx")
        d = docx.Document(str(path))
        parts = [p.text for p in d.paragraphs if p.text]
        return "\n".join(parts), "docx"

    raise RuntimeError(f"Unsupported file type: {suffix}")


