import os
import re
from decimal import Decimal
from typing import Optional, Tuple, Dict, Set, List

import psycopg2
from psycopg2.extras import DictCursor


# -----------------------------
# Text normalization
# -----------------------------


def clean_text(s: str) -> str:
    # Normalize common weird LinkedIn copy/paste artifacts
    s = s.replace("\u00a0", " ")
    # collapse whitespace
    s = re.sub(r"[ \t]+", " ", s)
    return s.strip()


def normalize_for_matching(s: str) -> str:
    s = s.lower().replace("\u00a0", " ")
    s = re.sub(r"\s+", " ", s)
    return s.strip()


# -----------------------------
# Workplace + Salary parsing
# -----------------------------


def parse_workplace_type(text: str) -> Optional[str]:
    t = text.lower()
    if re.search(r"\bremote\b", t):
        return "remote"
    if re.search(r"\bhybrid\b", t):
        return "hybrid"
    if re.search(r"\bon[- ]?site\b|\bonsite\b|\bin office\b", t):
        return "onsite"
    return None


def _money_to_number(x: str) -> Optional[Decimal]:
    x = x.strip().replace(",", "").replace("$", "")
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([kKmM]?)", x)
    if not m:
        return None
    val = Decimal(m.group(1))
    suffix = m.group(2).lower()
    if suffix == "k":
        val *= 1000
    elif suffix == "m":
        val *= 1000000
    return val


def parse_salary_range(
    text: str,
) -> Tuple[Optional[Decimal], Optional[Decimal], Optional[str]]:
    """
    Tries common formats:
      "$81.6K/yr - $102K/yr"
      "Annual base salary range $81,600 - 102,000"
      "$55,000 - $160,000"
    Returns (min, max, period) where period in {"year","hour","month"} or None.
    """
    t = clean_text(text)

    dash = r"(?:-|–|—)"  # accept hyphen/en-dash/em-dash

    # 1) $81.6K/yr - $102K/yr
    m = re.search(
        rf"\$?\s*(\d+(?:\.\d+)?[kKmM]?)\s*/\s*(yr|year|hr|hour|mo|month)\s*{dash}\s*\$?\s*(\d+(?:\.\d+)?[kKmM]?)\s*/\s*(yr|year|hr|hour|mo|month)",
        t,
        flags=re.IGNORECASE,
    )
    if m:
        s1, p1, s2, p2 = m.group(1), m.group(2).lower(), m.group(3), m.group(4).lower()
        period = (
            "year" if p1.startswith("y") else "hour" if p1.startswith("h") else "month"
        )
        return _money_to_number(s1), _money_to_number(s2), period

    # 2) Annual base salary range $81,600 - 102,000
    m = re.search(
        rf"(annual\s+base\s+salary\s+range|base\s+pay\s+range|salary\s+range)\s*\$?\s*([\d,]+(?:\.\d+)?)\s*{dash}\s*\$?\s*([\d,]+(?:\.\d+)?)",
        t,
        flags=re.IGNORECASE,
    )
    if m:
        return _money_to_number(m.group(2)), _money_to_number(m.group(3)), "year"


# 3) Generic salary ranges MUST look like money, not "1-2 years"
# Require at least one of:
#   - a $ sign
#   - a K/M suffix
#   - salary-ish words nearby
m = re.search(
    rf"(?i)(salary|compensation|pay|base)\D{{0,40}}(\$?\s*[\d,]+(?:\.\d+)?[kKmM]?)\s*{dash}\s*\$?\s*([\d,]+(?:\.\d+)?[kKmM]?)"
    rf"|(\$\s*[\d,]+(?:\.\d+)?[kKmM]?)\s*{dash}\s*(\$\s*[\d,]+(?:\.\d+)?[kKmM]?)",
    t,
)
if m:
    if m.group(2) and m.group(3):
        return _money_to_number(m.group(2)), _money_to_number(m.group(3)), None
    if m.group(4) and m.group(5):
        return _money_to_number(m.group(4)), _money_to_number(m.group(5)), None

    return None, None, None


# -----------------------------
# Title / Company / Location extraction
# -----------------------------


def extract_title_company_location_from_description(
    desc: str,
) -> Dict[str, Optional[str]]:
    lines = [clean_text(x) for x in desc.splitlines()]
    lines = [x for x in lines if x]
    top = lines[:30]

    # location: "Seattle, WA" or fallback "United States"
    location = None
    state = None
    for line in top:
        m = re.search(r"\b([A-Za-z .'-]+),\s*([A-Z]{2})\b", line)
        if m:
            location = m.group(1).strip()
            state = m.group(2).strip()
            break

    if not location:
        for line in top:
            if re.search(r"\bUnited States\b", line, flags=re.IGNORECASE):
                location = "United States"
                state = None
                break

    title = None
    title_keywords = r"(analyst|analytics|engineer|scientist|manager|director|specialist|strategist|consultant)"
    for line in top:
        low = line.lower()
        if re.search(title_keywords, line, flags=re.IGNORECASE):
            if any(bad in low for bad in ["job alert", "reposted", "clicked apply"]):
                continue
            if low.strip() == "apply":
                continue
            title = line.strip(" -•")
            break

    company = None
    for line in top[:10]:
        low = line.lower()
        if any(
            bad in low
            for bad in [
                "reposted",
                "clicked apply",
                "promoted by",
                "responses managed",
                "full-time",
                "part-time",
                "contract",
                "apply",
                "saved",
                "about the job",
                "use ai",
                "show match",
                "tailor",
                "$",
            ]
        ):
            continue
        if title and line == title:
            continue
        if len(line) <= 2 or len(line) > 60:
            continue
        if re.search(title_keywords, line, flags=re.IGNORECASE):
            continue
        company = line.strip(" -•")
        break

    return {"title": title, "company": company, "location": location, "state": state}


# -----------------------------
# Role archetype inference (optional / best-effort)
# -----------------------------


def infer_role_archetype(title: str) -> Optional[str]:
    t = title.lower()
    if "business intelligence" in t or re.search(r"\bbi\b", t):
        return "bi_analytics"
    if (
        "sales ops" in t
        or "sales operations" in t
        or "revops" in t
        or "revenue ops" in t
    ):
        return "sales_operations"
    if "product" in t or "growth" in t or "experiment" in t:
        return "product_analytics"
    if "strategy" in t or "strategic" in t:
        return "strategy"
    if "data engineer" in t or "analytics engineer" in t:
        return "data_engineering"
    if "data analyst" in t or "analyst" in t:
        return "general_analytics"
    return None


# -----------------------------
# Experience level inference
# -----------------------------


def infer_experience_level(desc: str) -> Optional[str]:
    """
    Rules (per your spec):
      - If description contains explicit level words, honor them:
        entry / associate / mid / senior (also junior -> entry-ish)
      - Else infer from years:
        0-anything => entry
        1+ years => associate
        3-5 years => mid
        5+ years => senior
    """
    t = normalize_for_matching(desc)

    # explicit keywords win
    explicit_map = [
        (r"\bsenior\b|\bsr\.?\b", "senior"),
        (r"\bmid\b|\bmid-level\b|\bmid level\b", "mid"),
        (r"\bassociate\b", "associate"),
        (r"\bentry\b|\bentry-level\b|\bentry level\b|\bjunior\b|\bjr\.?\b", "entry"),
    ]
    for pat, lvl in explicit_map:
        if re.search(pat, t):
            return lvl

    # years patterns
    m_plus = re.search(r"\b(\d+)\s*\+\s*years?\b", t)
    if m_plus:
        n = int(m_plus.group(1))
        if n >= 5:
            return "senior"
        if n >= 3:
            return "mid"
        if n >= 1:
            return "associate"
        return "entry"

    dash = r"(?:-|–|—)"  # hyphen / en-dash / em-dash

    m_range = re.search(rf"\b(\d+)\s*(?:{dash}|to)\s*(\d+)\s*years?\b", t)
    if m_range:
        lo = int(m_range.group(1))
        hi = int(m_range.group(2))

        if lo == 0:
            return "entry"
        if lo >= 5:
            return "senior"
        if lo == 3 and hi == 5:
            return "mid"
        if lo >= 3 and hi <= 5:
            return "mid"
        if lo >= 1:
            return "associate"
        return "entry"

    return None


# -----------------------------
# Skill extraction + priority classification
# -----------------------------


def build_alias_pattern(alias_text: str) -> re.Pattern:
    a = alias_text.strip().lower()
    esc = re.escape(a)
    esc = esc.replace(r"\ ", r"\s*")
    esc = esc.replace(r"\/", r"\s*/\s*")
    esc = esc.replace(r"\-", r"\s*-\s*")

    prefix = r"\b" if re.match(r"^[a-z0-9]", a) else ""
    suffix = r"\b" if re.match(r".*[a-z0-9]$", a) else ""
    pattern = prefix + esc + suffix
    return re.compile(pattern, flags=re.IGNORECASE)


def load_skill_alias_patterns(cur) -> List[Tuple[re.Pattern, str, str]]:
    cur.execute("SELECT alias_text, skill_id FROM skill_aliases")
    rows = cur.fetchall()

    compiled: List[Tuple[re.Pattern, str, str]] = []
    for r in rows:
        alias_text = (r["alias_text"] if isinstance(r, dict) else r[0]) or ""
        skill_id = (r["skill_id"] if isinstance(r, dict) else r[1]) or ""
        alias_text = alias_text.strip().lower()
        if not alias_text or not skill_id:
            continue
        compiled.append((build_alias_pattern(alias_text), skill_id, alias_text))

    compiled.sort(key=lambda x: len(x[2]), reverse=True)
    return compiled


def detect_priority_from_line(line: str) -> Optional[str]:
    l = normalize_for_matching(line)

    if re.search(r"\b(nice to have|nice-to-have|bonus|a plus|good to have)\b", l):
        return "nice-to-have"
    if re.search(r"\b(preferred|preferably|would be great|plus if)\b", l):
        return "preferred"
    if re.search(r"\b(required|must have|must-have|need to have)\b", l):
        return "required"
    return None


def infer_section_priority(header_line: str) -> Optional[str]:
    l = normalize_for_matching(header_line)

    if re.search(r"\b(nice to have|nice-to-have|bonus|additional)\b", l):
        return "nice-to-have"
    if re.search(r"\b(preferred qualifications|preferred)\b", l):
        return "preferred"
    if re.search(r"\b(requirements|required qualifications|must have)\b", l):
        return "required"
    if re.search(r"\b(qualifications|what you will have|what you'll have)\b", l):
        return "required"
    return None


def extract_skill_priorities(
    desc: str, compiled_patterns: List[Tuple[re.Pattern, str, str]]
) -> Dict[str, str]:
    """
    Returns: {skill_id: skill_priority}
    Default: required (per your rule)
    Strongest wins: required > preferred > nice-to-have
    """
    priority_rank = {"required": 3, "preferred": 2, "nice-to-have": 1}

    lines = [clean_text(x) for x in desc.splitlines()]
    lines = [x for x in lines if x]

    current_section = None
    out: Dict[str, str] = {}

    for line in lines:
        new_section = infer_section_priority(line)
        if new_section:
            current_section = new_section

        line_priority = detect_priority_from_line(line)
        t = normalize_for_matching(line)

        for pat, skill_id, _alias in compiled_patterns:
            if pat.search(t):
                p = line_priority or current_section or "required"
                if skill_id not in out:
                    out[skill_id] = p
                else:
                    if priority_rank.get(p, 0) > priority_rank.get(out[skill_id], 0):
                        out[skill_id] = p

    return out


# -----------------------------
# DB helpers
# -----------------------------


def get_conn():
    return psycopg2.connect(
        host=os.getenv("PGHOST", "localhost"),
        port=int(os.getenv("PGPORT", "5432")),
        dbname=os.getenv("PGDATABASE", "job_analytics"),
        user=os.getenv("PGUSER"),
        password=os.getenv("PGPASSWORD"),
    )


def next_id(cur, table: str, id_col: str, prefix: str, width: int) -> str:
    cur.execute(
        f"SELECT {id_col} FROM {table} WHERE {id_col} LIKE %s ORDER BY {id_col} DESC LIMIT 1",
        (f"{prefix}%",),
    )
    row = cur.fetchone()
    if not row:
        n = 1
    else:
        last = row[0] if not isinstance(row, dict) else row[id_col]
        n = int(re.sub(r"\D", "", last)) + 1
    return f"{prefix}{n:0{width}d}"


def upsert_company(cur, company_name: str) -> str:
    cur.execute(
        "SELECT company_id FROM companies WHERE lower(company_name)=lower(%s) LIMIT 1",
        (company_name,),
    )
    row = cur.fetchone()
    if row:
        return row[0]
    new_id = next_id(cur, "companies", "company_id", "C", 3)
    cur.execute(
        "INSERT INTO companies (company_id, company_name) VALUES (%s, %s)",
        (new_id, company_name),
    )
    return new_id


def upsert_role(cur, role_name: str) -> str:
    cur.execute(
        "SELECT role_id FROM roles WHERE lower(role_name)=lower(%s) LIMIT 1",
        (role_name,),
    )
    row = cur.fetchone()
    if row:
        return row[0]
    new_id = next_id(cur, "roles", "role_id", "R", 3)
    archetype = infer_role_archetype(role_name)
    cur.execute(
        "INSERT INTO roles (role_id, role_name, role_archetype) VALUES (%s, %s, %s)",
        (new_id, role_name, archetype),
    )
    return new_id


def upsert_location(cur, location: str, state: Optional[str]) -> str:
    cur.execute(
        """
        SELECT location_id
        FROM locations
        WHERE lower(location)=lower(%s)
          AND ( (state IS NULL AND %s IS NULL) OR (state=%s) )
        LIMIT 1
        """,
        (location, state, state),
    )
    row = cur.fetchone()
    if row:
        return row[0]
    new_id = next_id(cur, "locations", "location_id", "L", 3)
    cur.execute(
        "INSERT INTO locations (location_id, location, state) VALUES (%s, %s, %s)",
        (new_id, location, state),
    )
    return new_id


def next_job_skill_id(cur) -> str:
    """
    Your format: JS0001 (4 digits)
    """
    prefix = "JS"
    cur.execute(
        "SELECT job_skills_id FROM job_skills WHERE job_skills_id LIKE %s ORDER BY job_skills_id DESC LIMIT 1",
        (f"{prefix}%",),
    )
    row = cur.fetchone()
    if not row:
        n = 1
    else:
        last = row[0] if not isinstance(row, dict) else row["job_skills_id"]
        n = int(re.sub(r"\D", "", last)) + 1
    return f"{prefix}{n:04d}"


def insert_or_update_job_skills(
    cur, job_id: str, skill_priority_map: Dict[str, str]
) -> Tuple[int, int]:
    if not skill_priority_map:
        return 0, 0

    cur.execute(
        "SELECT skill_id, skill_priority FROM job_skills WHERE job_id=%s", (job_id,)
    )
    existing_rows = cur.fetchall()

    existing: Dict[str, Optional[str]] = {}
    for r in existing_rows:
        sid = r[0] if not isinstance(r, dict) else r["skill_id"]
        pri = r[1] if not isinstance(r, dict) else r["skill_priority"]
        existing[sid] = pri

    inserted = 0
    updated = 0

    for sid, pri in skill_priority_map.items():
        if sid not in existing:
            js_id = next_job_skill_id(cur)
            cur.execute(
                """
                INSERT INTO job_skills (job_skills_id, job_id, skill_id, skill_priority)
                VALUES (%s, %s, %s, %s)
                """,
                (js_id, job_id, sid, pri),
            )
            inserted += 1
        else:
            cur_pri = existing.get(sid)
            if cur_pri is None or str(cur_pri).strip() == "":
                cur.execute(
                    """
                    UPDATE job_skills
                    SET skill_priority=%s
                    WHERE job_id=%s AND skill_id=%s
                    """,
                    (pri, job_id, sid),
                )
                updated += 1

    return inserted, updated


# -----------------------------
# Main
# -----------------------------


def main():
    conn = get_conn()
    conn.autocommit = False

    try:
        with conn.cursor(cursor_factory=DictCursor) as cur:
            compiled_patterns = load_skill_alias_patterns(cur)

            cur.execute(
                """
                SELECT jp.job_id, jp.description_text, jp.company_id, jp.role_id, jp.location_id,
                       jp.workplace_type, jp.salary_min, jp.salary_max, jp.salary_period,
                       jp.experience_level
                FROM job_postings jp
                LEFT JOIN job_skills js ON js.job_id = jp.job_id
                WHERE jp.description_text IS NOT NULL
                  AND (
                        jp.company_id IS NULL
                     OR jp.role_id IS NULL
                     OR jp.location_id IS NULL
                     OR jp.workplace_type IS NULL
                     OR jp.salary_min IS NULL
                     OR jp.salary_max IS NULL
                     OR jp.salary_period IS NULL
                     OR jp.experience_level IS NULL
                     OR js.job_id IS NULL
                  )
                GROUP BY jp.job_id, jp.description_text, jp.company_id, jp.role_id, jp.location_id,
                         jp.workplace_type, jp.salary_min, jp.salary_max, jp.salary_period, jp.experience_level
                ORDER BY jp.job_id
                """
            )
            jobs = cur.fetchall()

            updated_jobs = 0
            inserted_job_skills = 0
            updated_job_skills = 0

            for job in jobs:
                job_id = job["job_id"]
                desc = job["description_text"] or ""
                if not desc.strip():
                    continue

                extracted = extract_title_company_location_from_description(desc)

                # parse salary/workplace
                smin, smax, period = parse_salary_range(desc)
                workplace = parse_workplace_type(desc)

                # infer experience
                exp_level = infer_experience_level(desc)

                # upsert dimensions if missing
                company_id = job["company_id"]
                if (not company_id) and extracted["company"]:
                    company_id = upsert_company(cur, extracted["company"])

                role_id = job["role_id"]
                if (not role_id) and extracted["title"]:
                    role_id = upsert_role(cur, extracted["title"])

                location_id = job["location_id"]
                if (not location_id) and extracted["location"]:
                    location_id = upsert_location(
                        cur, extracted["location"], extracted["state"]
                    )

                # update job_postings only for fields we actually found /
                # inferred
                fields = []
                params = []

                if company_id and company_id != job["company_id"]:
                    fields.append("company_id=%s")
                    params.append(company_id)
                if role_id and role_id != job["role_id"]:
                    fields.append("role_id=%s")
                    params.append(role_id)
                if location_id and location_id != job["location_id"]:
                    fields.append("location_id=%s")
                    params.append(location_id)

                if workplace and workplace != job["workplace_type"]:
                    fields.append("workplace_type=%s")
                    params.append(workplace)

                if smin is not None and smin != job["salary_min"]:
                    fields.append("salary_min=%s")
                    params.append(smin)
                if smax is not None and smax != job["salary_max"]:
                    fields.append("salary_max=%s")
                    params.append(smax)
                if period is not None and period != job["salary_period"]:
                    fields.append("salary_period=%s")
                    params.append(period)

                if exp_level is not None and exp_level != job["experience_level"]:
                    fields.append("experience_level=%s")
                    params.append(exp_level)

                if fields:
                    params.append(job_id)
                    cur.execute(
                        f"UPDATE job_postings SET {', '.join(fields)} WHERE job_id=%s",
                        tuple(params),
                    )
                    updated_jobs += 1
                    print(
                        f"Updated {job_id}: {', '.join([f.split('=')[0] for f in fields])}"
                    )

                # skill extraction + priority classification + insert/update
                skill_priority_map = extract_skill_priorities(desc, compiled_patterns)
                ins, upd = insert_or_update_job_skills(cur, job_id, skill_priority_map)
                if ins:
                    inserted_job_skills += ins
                    print(f"Inserted {ins} job_skills rows for {job_id}")
                if upd:
                    updated_job_skills += upd
                    print(f"Updated {upd} job_skills priorities for {job_id}")

            conn.commit()
            print("\nDone.")
            print(f"Updated job_postings rows: {updated_jobs}")
            print(f"Inserted job_skills rows: {inserted_job_skills}")
            print(f"Updated job_skills rows: {updated_job_skills}")

    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


if __name__ == "__main__":
    main()
