from typing import Optional
from psycopg2.extras import DictCursor

def write_monthly_skill_snapshot(cur, run_id: str) -> int:
    """
    Writes/updates an aggregated snapshot of skill demand by month_found (job_postings.date_found),
    experience_level, and skill_priority.

    Returns: number of rows affected (Postgres rowcount from INSERT...ON CONFLICT).
    """
    cur.execute(
        """
        INSERT INTO skill_demand_monthly_snapshots (
            snapshot_date, run_id, month_bucket, skill_id, experience_level, skill_priority,
            jobs_count, avg_salary_min, avg_salary_max
        )
        SELECT
            CURRENT_DATE AS snapshot_date,
            %s AS run_id,
            date_trunc('month', jp.date_found)::date AS month_bucket,
            js.skill_id,
            COALESCE(NULLIF(jp.experience_level, ''), 'unknown') AS experience_level,
            COALESCE(NULLIF(js.skill_priority, ''), 'required') AS skill_priority,
            COUNT(DISTINCT jp.job_id) AS jobs_count,
            AVG(CASE WHEN jp.salary_period = 'year' THEN jp.salary_min END) AS avg_salary_min,
            AVG(CASE WHEN jp.salary_period = 'year' THEN jp.salary_max END) AS avg_salary_max
        FROM job_postings jp
        JOIN job_skills js ON js.job_id = jp.job_id
        WHERE jp.date_found IS NOT NULL
          AND COALESCE(jp.status,'') <> 'legacy_no_desc'
          AND jp.description_text IS NOT NULL
          AND btrim(jp.description_text) <> ''
        GROUP BY 1,2,3,4,5,6
        ON CONFLICT (snapshot_date, month_bucket, skill_id, experience_level, skill_priority)
        DO UPDATE SET
            run_id = EXCLUDED.run_id,
            jobs_count = EXCLUDED.jobs_count,
            avg_salary_min = EXCLUDED.avg_salary_min,
            avg_salary_max = EXCLUDED.avg_salary_max
        ;

        """,
        (run_id,)
    )
    return cur.rowcount
