  group_id      text NOT NULL REFERENCES skill_groups(group_id) ON DELETE CASCADE,
  level_bucket  text NOT NULL,
  weight        numeric NOT NULL DEFAULT 1.0,
  PRIMARY KEY (group_id, level_bucket)
);

