-- ------------------------------------------------------------
-- 4) Plausibility penalty function
--    Uses REQUIRED skills as primary signal; preferred is weaker.
-- ------------------------------------------------------------

CREATE OR REPLACE FUNCTION _honesty_plausibility_penalty(job_id_in text)
RETURNS TABLE(penalty int, flags jsonb)
LANGUAGE sql
AS $$
WITH lvl AS (
  SELECT
    jp.job_id,
    COALESCE(jp.experience_level, 'unknown') AS experience_level,
    CASE
      WHEN COALESCE(jp.experience_level,'') IN ('entry') THEN 'entry'
      WHEN COALESCE(jp.experience_level,'') IN ('associate','junior') THEN 'associate'
      WHEN COALESCE(jp.experience_level,'') IN ('mid','intermediate') THEN 'mid'
      WHEN COALESCE(jp.experience_level,'') IN ('senior','lead','principal','staff') THEN 'senior'
      ELSE 'unknown'
    END AS level_bucket
  FROM job_postings jp
  WHERE jp.job_id = job_id_in
),
req AS (
  SELECT
    js.job_id,
    COUNT(*) FILTER (WHERE js.skill_priority = 'required') AS required_skills,
    COUNT(*) FILTER (WHERE js.skill_priority = 'preferred') AS preferred_skills
  FROM job_skills js
  WHERE js.job_id = job_id_in
  GROUP BY js.job_id
),
grp AS (
  SELECT
    js.job_id,
    sg.group_id,
    COUNT(*) FILTER (WHERE js.skill_priority = 'required')  AS req_in_group,
    COUNT(*) FILTER (WHERE js.skill_priority = 'preferred') AS pref_in_group
  FROM job_skills js
  JOIN skill_group_members sgm ON sgm.skill_id = js.skill_id
  JOIN skill_groups sg ON sg.group_id = sgm.group_id
  WHERE js.job_id = job_id_in
  GROUP BY 1,2
),
weighted AS (
  SELECT
    g.job_id,
    SUM(
      (g.req_in_group * COALESCE(w_lvl.weight, w_any.weight, 1.0))
      + (g.pref_in_group * 0.35 * COALESCE(w_lvl.weight, w_any.weight, 1.0))
    ) AS seniority_points,
    SUM(g.req_in_group) AS req_group_hits,
    SUM(g.pref_in_group) AS pref_group_hits,
    MAX(CASE WHEN g.group_id='G_CLOUD_INF' THEN g.req_in_group ELSE 0 END) AS req_cloud,
    MAX(CASE WHEN g.group_id='G_ML_DS'     THEN g.req_in_group ELSE 0 END) AS req_ml,
    MAX(CASE WHEN g.group_id='G_DE_CORE'   THEN g.req_in_group ELSE 0 END) AS req_de
  FROM grp g
  JOIN lvl l ON l.job_id = g.job_id
  LEFT JOIN skill_group_weights w_any ON w_any.group_id=g.group_id AND w_any.level_bucket='any'
  LEFT JOIN skill_group_weights w_lvl ON w_lvl.group_id=g.group_id AND w_lvl.level_bucket=l.level_bucket
  GROUP BY 1
),
calc AS (
  SELECT
    l.job_id,
    l.level_bucket,
    COALESCE(r.required_skills,0) AS required_skills,
    COALESCE(r.preferred_skills,0) AS preferred_skills,
    COALESCE(w.seniority_points,0)::numeric AS seniority_points,
    COALESCE(w.req_group_hits,0) AS req_group_hits,
    COALESCE(w.pref_group_hits,0) AS pref_group_hits,
    COALESCE(w.req_cloud,0) AS req_cloud,
    COALESCE(w.req_ml,0) AS req_ml,
    COALESCE(w.req_de,0) AS req_de
  FROM lvl l
  LEFT JOIN req r ON r.job_id = l.job_id
  LEFT JOIN weighted w ON w.job_id = l.job_id
),
pen AS (
  SELECT
    c.job_id,
    -- NASTY RULESET:
    (
      CASE
        -- entry: seniority_points thresholding
        WHEN c.level_bucket='entry' AND c.seniority_points >= 7.5 THEN 22
        WHEN c.level_bucket='entry' AND c.seniority_points >= 5.5 THEN 14
        WHEN c.level_bucket='entry' AND c.seniority_points >= 4.0 THEN 8
        -- associate
        WHEN c.level_bucket='associate' AND c.seniority_points >= 8.5 THEN 14
        WHEN c.level_bucket='associate' AND c.seniority_points >= 6.5 THEN 8
        -- mid
        WHEN c.level_bucket='mid' AND c.seniority_points >= 10.0 THEN 8
        ELSE 0
      END
      -- “full-stack scope” smell: lots of required skills regardless of grouping
      + CASE
          WHEN c.level_bucket='entry' AND c.required_skills >= 12 THEN 10
          WHEN c.level_bucket='entry' AND c.required_skills >= 9  THEN 6
          WHEN c.level_bucket IN ('associate','mid') AND c.required_skills >= 14 THEN 6
          ELSE 0
        END
      -- “cross-discipline ask” smell: DE + ML + Cloud required in same entry posting
      + CASE
          WHEN c.level_bucket='entry' AND c.req_de >= 1 AND c.req_ml >= 1 AND c.req_cloud >= 1 THEN 10
          WHEN c.level_bucket='entry' AND c.req_ml >= 2 THEN 6
          ELSE 0
        END
    )::int AS penalty,
    (
      '[]'::jsonb
      || CASE WHEN c.level_bucket='entry' AND c.seniority_points >= 5.5 THEN to_jsonb('entry_senior_stack') ELSE '[]'::jsonb END
      || CASE WHEN c.level_bucket='entry' AND c.required_skills >= 9 THEN to_jsonb('entry_fullstack_scope') ELSE '[]'::jsonb END
      || CASE WHEN c.level_bucket='entry' AND c.req_de >= 1 AND c.req_ml >= 1 AND c.req_cloud >= 1 THEN to_jsonb('entry_cross_discipline_stack') ELSE '[]'::jsonb END
      || CASE WHEN c.level_bucket='associate' AND c.seniority_points >= 8.5 THEN to_jsonb('associate_senior_stack') ELSE '[]'::jsonb END
    ) AS flags
  FROM calc c
)
SELECT
  LEAST(penalty, 25)::int AS penalty,
  flags
FROM pen;
$$;

